# Q&M WhatsApp Gateway — configuration
# Copy to .env and adjust.

# Where to forward every inbound WhatsApp message (the CrewAI backend webhook).
BACKEND_WEBHOOK_URL=http://localhost:8000/webhook/whatsapp

# Port this gateway listens on for outbound /send-reply requests.
REPLY_SERVER_PORT=3000

# Path to a Chrome/Chromium executable for whatsapp-web.js (Puppeteer).
CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Run the browser headless (true) or visible (false). Visible is easier for the
# first QR scan; switch to true once the session is saved in .wwebjs_auth.
HEADLESS=false

# How long to wait for the backend to process before timing out (ms).
FORWARD_TIMEOUT_MS=120000
