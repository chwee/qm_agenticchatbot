# Q&M AI Enquiry & Enrollment System — backend configuration
# Copy to .env and fill in. Only OPENAI_API_KEY is strictly required to run.

# ── OpenAI (LLM + vision LLM) ───────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.2

# ── PostgreSQL — choose a provider ──────────────────────────────────────────
# DB_PROVIDER selects which DATABASE_URL_* below the backend connects to:
#   docker    → local Docker Compose Postgres (docker-compose.yml)
#   supabase  → hosted Supabase Postgres (backend/db/supabase_export.sql
#               loads the matching schema + data onto a fresh project)
DB_PROVIDER=docker

DATABASE_URL_DOCKER=postgresql://qm_user:qm_password@localhost:5432/qm_enrollment

# From Supabase: Project Settings -> Database -> Connection string (Session
# pooler or Direct connection). sslmode=require is mandatory on Supabase.
DATABASE_URL_SUPABASE=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Explicit override — if set, DATABASE_URL is used as-is and DB_PROVIDER is
# ignored entirely. Back-compat with .env files predating DB_PROVIDER; leave
# blank to let DB_PROVIDER decide.
DATABASE_URL=

# ── Backend server ──────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ── WhatsApp gateway (outbound) ─────────────────────────────────────────────
# Where the backend sends outbound replies (the Node gateway /send-reply).
WHATSAPP_SEND_URL=http://localhost:3000/send-reply
# Set false to log replies to console instead of calling the gateway (dev/test).
WHATSAPP_ENABLED=true

# ── Email delivery (SMTP) — Module B invoices, Module C receipts ────────────
# Leave EMAIL_ENABLED=false to log emails to console + save PDFs locally only.
# Demo: smtp.freesmtpservers.com is a free, no-auth catch-all relay (see
# scripts/testemail.py) — good enough to prove the invoice-email flow works
# without real SMTP credentials. For production, swap SMTP_HOST/PORT/USER/
# PASSWORD/USE_TLS for your real provider (e.g. Gmail, SES, Postmark) —
# nothing else in the code needs to change.
EMAIL_ENABLED=true
SMTP_HOST=smtp.freesmtpservers.com
SMTP_PORT=25
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Q&M Training <no-reply@example.com>
SMTP_USE_TLS=false

# Staff escalation inbox (Module A flag) + accounts inbox (Module C reports).
STAFF_EMAIL=staff@example.com
ACCOUNTS_EMAIL=accounts@example.com

# ── Company / payment details (invoice + PayNow) ────────────────────────────
COMPANY_NAME=Q&M Dental Group (Singapore) Limited
COMPANY_UEN=200008000C
PAYNOW_UEN=200008000C
PAYNOW_PAYEE=Q&M Dental Group

# ── Module C auto-confirm threshold (vision confidence 0..1) ────────────────
AUTO_CONFIRM_THRESHOLD=0.80

# ── Scheduler (Module A nurture follow-ups, Module C nightly report) ────────
SCHEDULER_ENABLED=true
# Per-job switches — only apply while SCHEDULER_ENABLED=true above; set any
# of these false to silence just that job without stopping the others.
SCHEDULER_FOLLOWUPS_ENABLED=true
SCHEDULER_NIGHTLY_REPORT_ENABLED=true
SCHEDULER_REMINDER_DISPATCH_ENABLED=true
SCHEDULER_CREDIT_NOTE_DISPATCH_ENABLED=true
FOLLOWUP_CHECK_CRON_HOUR=9
NIGHTLY_REPORT_CRON_HOUR=20

# ── Query/data-flow logging ──────────────────────────────────────────────────
# Writes the query -> orchestration -> agent -> tools -> response trace for
# every turn to a daily text file in backend/logs/ (in addition to console).
# Set false to disable the file write (console trace still prints).
QUERY_LOG_ENABLED=true
